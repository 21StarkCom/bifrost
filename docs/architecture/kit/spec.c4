// Generated by floorplan from its kit. Do not edit: floorplan build writes this file again.
// The floorplan kit: the C4 model vocabulary (https://c4model.com).
// Floorplan has no fixed element kinds, so this file defines the C4 ones.
// Colours are the C4 roles of the draupnir house theme: a fixed blue scale and
// the theme's own neutral. The studio, the site and the PNGs paint them from the
// theme on each stone (`@21starkcom/likec4/bridge.css`). The hex values are the
// light stone, for Floorplan's colour maths and for the Miro plan, draw.io and
// Mermaid. `packages/floorplan/src/__tests__/kit-colors.spec.ts` holds them to the theme.

specification {
  color c4-person #113264
  color c4-system #0D74CE
  color c4-container #5EB1EF
  color c4-component #ACD8FC
  color c4-external #F1F0EF

  // Level 1: people and software systems
  element person {
    notation "Person"
    style {
      shape person
      color c4-person
    }
  }
  element softwareSystem {
    notation "Software System"
    style {
      color c4-system
    }
  }
  element externalSystem {
    notation "Software System (external)"
    style {
      color c4-external
    }
  }

  // Level 2: containers (apps and data stores)
  element container {
    notation "Container"
    style {
      color c4-container
    }
  }
  element webApp {
    notation "Container: Web Application"
    style {
      shape browser
      color c4-container
    }
  }
  element mobileApp {
    notation "Container: Mobile App"
    style {
      shape mobile
      color c4-container
    }
  }
  element database {
    notation "Container: Database"
    style {
      shape storage
      color c4-container
    }
  }
  element queue {
    notation "Container: Queue"
    style {
      shape queue
      color c4-container
    }
  }

  // Level 3: components
  element component {
    notation "Component"
    style {
      color c4-component
    }
  }

  // Deployment: where the containers run. floorplan scan writes these nodes from Terraform files.
  // The kinds use the five colours above, so the kit has no other colour.
  deploymentNode environment {
    notation "Deployment: Environment"
    style {
      color c4-external
    }
  }
  deploymentNode gcpProject {
    notation "Deployment: GCP Project"
    style {
      color c4-external
    }
  }
  deploymentNode network {
    notation "Deployment: Network"
    style {
      color c4-external
    }
  }
  deploymentNode subnet {
    notation "Deployment: Subnet"
    style {
      color c4-external
    }
  }
  deploymentNode cluster {
    notation "Deployment: Kubernetes Cluster"
    style {
      color c4-system
    }
  }
  deploymentNode vm {
    notation "Deployment: Virtual Machine"
    style {
      color c4-system
    }
  }
  deploymentNode nat {
    notation "Deployment: NAT"
    style {
      color c4-external
    }
  }
  deploymentNode managedService {
    notation "Deployment: Managed Service"
    style {
      color c4-component
    }
  }

  relationship async {
    line dotted
  }
  relationship sync {
    line solid
  }
}
