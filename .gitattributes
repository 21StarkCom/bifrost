# could never be resolved by editing this repo. Refresh recipe + pinned upstream tag:
# engine/internal/starktui/README.md. Pinned by engine/cmd/stark/gitattributes_test.go.
engine/internal/starktui/** linguist-generated=true
index.json linguist-generated=true
bundles/** linguist-generated=true
.claude-plugin/** linguist-generated=true
