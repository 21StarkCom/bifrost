# ── Agent + session scratch ───────────────────────────────────────────
.claude/
.superpowers/
# config/settings.json's first SessionStart hook runs
# `mkdir -p "${CLAUDE_PROJECT_DIR:-.}/.remember/logs"` in every repo it applies to.
.remember/

# ── Dependencies ──────────────────────────────────────────────────────
node_modules/

# ── Skill outputs written into the repo under test ────────────────────
# tools/skill_optimize.ts + tools/skill_autopilot.ts stage under artifacts/skill-optimizer/;
# /stark-refactor-plan writes the two root artifacts plus its intermediates.
artifacts/
.refactor-planner/
/REFACTOR_PLAN.md
/REFACTOR_BACKLOG.json

# ── Local Codex install outputs ───────────────────────────────────────
.agents/
.codex/
.stark/
/config.toml

# ── Local git worktrees (idun gh pr-open does `git add -A`) ───────────
/.worktrees/

# ── Local env + noise ─────────────────────────────────────────────────
.env
.env.*
.DS_Store
*.log
